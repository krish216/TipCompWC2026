# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_key

# ── Payments (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Stripe Payment Link for donations ("customers choose what to pay"). Footer
# "Support us" link/button only appears when this is set. e.g. https://donate.stripe.com/xxxx
DONATE_URL=

# ── Football data API (results auto-sync) ─────────────────────
# football-data.org — free tier includes the FIFA World Cup. Get a token at
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
# Optional overrides — default to the World Cup (code WC), provider's current season.
# FOOTBALL_DATA_COMPETITION=WC
# FOOTBALL_DATA_SEASON=2026

# ── Push notifications (OneSignal) ───────────────────────────
ONESIGNAL_APP_ID=your-app-id
ONESIGNAL_API_KEY=your-api-key

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WC2026 Predictor

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourapp.com

# ── Cron security ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ── Testing ───────────────────────────────────────────────────
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
