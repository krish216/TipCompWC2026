# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_key

# ── Payments (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Stripe Payment Link for donations ("customers choose what to pay"). Footer
# "Support us" link/button only appears when this is set. e.g. https://donate.stripe.com/xxxx
DONATE_URL=

# ── Football data API ─────────────────────────────────────────
# Use EITHER a direct API-Sports key (dashboard.api-football.com) OR a RapidAPI key.
# If both are set, the direct key wins.
API_SPORTS_KEY=                 # direct key from dashboard.api-football.com
API_FOOTBALL_KEY=your_rapidapi_key   # RapidAPI proxy key (api-football-v1.p.rapidapi.com)
# Optional overrides — default to the FIFA World Cup (league 1) / 2026 season.
# API_FOOTBALL_LEAGUE_ID=1
# API_FOOTBALL_SEASON=2026

# ── Push notifications (OneSignal) ───────────────────────────
ONESIGNAL_APP_ID=your-app-id
ONESIGNAL_API_KEY=your-api-key

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WC2026 Predictor

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourapp.com

# ── Cron security ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ── Testing ───────────────────────────────────────────────────
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
